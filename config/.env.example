# TraceLink 模型与密钥配置示例
# 这个文件入版本库，只放键名与占位。真实值写同目录下的 .env（不进版本库）。
# 说明见 docs/LLM-CONFIG.md

# 火山引擎方舟推理密钥，放在 Authorization: Bearer 头里
ARK_API_KEY=

# 接口根地址，来自控制台，国内区默认如下
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 对话模型：推理接入点 ID（形如 ep-...）或控制台给出的模型标识
ARK_CHAT_MODEL=

# 向量模型与维度。维度要用 docs/LLM-CONFIG.md 第 7 节的 curl 实测，
# 并与 RAGFlow 侧的向量模型配置保持一致
ARK_EMBEDDING_MODEL=
ARK_EMBEDDING_DIM=1024

# 以下两项只在访问 Ark 之外的火山 OpenAPI 时需要（对象存储 TOS、IAM 等）
# 不要填进 ARK_API_KEY
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# RAGFlow 的接口地址与它自己签发的 API Key，与 ARK_API_KEY 无关
# API Key 在 RAGFlow 界面生成；Ark 的密钥填进 RAGFlow 的模型设置，不填这里
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=

# 库内敏感字段的加密主密钥，32 字节的 base64，只放环境变量
TL_SECRET_MASTER_KEY=
