# RAGFlow 的 compose 环境（取自官方 v0.17.0 的 docker/.env，按本机部署改了端口与镜像默认值）。
# scripts/ragflow-up.sh 首次运行会把本文件复制成 .env（.env 已在 .gitignore 中，密码不进版本库）。
# 官方建议 4 核 / 16 GB 内存 / 50 GB 磁盘；ES 的内存上限由 MEM_LIMIT 控制，内存吃紧可下调。

# 文档引擎：elasticsearch（默认）或 infinity；切换时 DOC_ENGINE 与 COMPOSE_PROFILES 两处一起改
DOC_ENGINE=elasticsearch
COMPOSE_PROFILES=elasticsearch

STACK_VERSION=8.11.3
ES_HOST=es01
ES_PORT=1200
ELASTIC_PASSWORD=infini_rag_flow

# ES 容器内存上限，单位字节（8 GB）
MEM_LIMIT=8073741824

INFINITY_HOST=infinity
INFINITY_THRIFT_PORT=23817
INFINITY_HTTP_PORT=23820
INFINITY_PSQL_PORT=5432

# RAGFlow 自用的 MySQL，端口避开本系统 MySQL 的 3306
MYSQL_PASSWORD=infini_rag_flow
MYSQL_HOST=mysql
MYSQL_DBNAME=rag_flow
MYSQL_PORT=5455

MINIO_HOST=minio
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=infini_rag_flow

# RAGFlow 的 /api/v1 端口，本系统 RAGFLOW_BASE_URL 默认指向它
SVR_HTTP_PORT=9380
# 浏览器端口，只用于首次进 RAGFlow 界面创建 API Key 与运维查看（映射容器内 80）
WEB_PORT=10080

# 固定到 v0.17 基线：本系统 RagFlowClient 按 v0.17 起的 /api/v1 接口形状实现。
# slim 版不含内置向量模型，模型在界面里指向 Ark；要离线跑内置模型再去掉 -slim。
RAGFLOW_IMAGE=infiniflow/ragflow:v0.17.0-slim

TIMEZONE='Asia/Shanghai'
# macOS 部署保持 1；Linux 部署改成 0 或注释掉
MACOS=1

# 访问 huggingface.co 受限时改成镜像地址，例如 https://hf-mirror.com
HF_ENDPOINT=
# 单文件上传上限（默认 128M），改了要同时改 nginx/nginx.conf 的 client_max_body_size
# MAX_CONTENT_LENGTH=134217728
